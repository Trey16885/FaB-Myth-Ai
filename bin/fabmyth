#!/usr/bin/env bash
#
# FaB-Myth-Ai  —  a friendly Ollama helper for Linux and Termux (Android)
#
# Run any downloadable model from the Ollama library on your device with a
# single, memorable command. Handles install, the background server, model
# downloads, chat, and diagnostics — with special care for Termux, where
# getting Ollama going is usually the hard part.
#
#   fabmyth setup              install Ollama for this platform
#   fabmyth start | stop       manage the background server
#   fabmyth pull <model>       download a model
#   fabmyth run  <model>       chat with a model (interactive)
#   fabmyth chat               pick an installed model and chat
#   fabmyth list               show installed models
#   fabmyth search [term]      browse popular models from the library
#   fabmyth doctor             diagnose your environment
#
# MIT License — Copyright (c) 2026 Trey16885
set -euo pipefail

FABMYTH_VERSION="0.7.0"

# ---------------------------------------------------------------------------
# Colors (disabled when not a TTY or NO_COLOR is set)
# ---------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'; C_CYAN=$'\033[36m'
else
  C_RESET=; C_BOLD=; C_DIM=; C_RED=; C_GREEN=; C_YELLOW=; C_BLUE=; C_CYAN=
fi

say()   { printf '%s\n' "$*"; }
info()  { printf '%s==>%s %s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$*"; }
ok()    { printf '%s✔%s %s\n'  "$C_GREEN" "$C_RESET" "$*"; }
warn()  { printf '%s!%s %s\n'  "$C_YELLOW" "$C_RESET" "$*" >&2; }
err()   { printf '%s\342\234\227%s %s\n'  "$C_RED" "$C_RESET" "$*" >&2; }
die()   { err "$*"; exit 1; }
have()  { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------------------
# Paths / environment
# ---------------------------------------------------------------------------
FABMYTH_HOME="${FABMYTH_HOME:-$HOME/.fabmyth}"
PID_FILE="$FABMYTH_HOME/ollama.pid"
LOG_FILE="$FABMYTH_HOME/ollama.log"
OLLAMA_HOST_DEFAULT="127.0.0.1:11434"
export OLLAMA_HOST="${OLLAMA_HOST:-$OLLAMA_HOST_DEFAULT}"

# Where `fabmyth update` fetches new versions from (override for testing/forks).
FABMYTH_REPO_RAW="${FABMYTH_REPO_RAW:-https://raw.githubusercontent.com/Trey16885/FaB-Myth-Ai}"

mkdir -p "$FABMYTH_HOME"

# ---------------------------------------------------------------------------
# Platform detection
# ---------------------------------------------------------------------------
IS_TERMUX=0
if [ -n "${TERMUX_VERSION:-}" ]; then
  IS_TERMUX=1
elif printf '%s' "${PREFIX:-}" | grep -q "com.termux"; then
  IS_TERMUX=1
elif have termux-setup-storage; then
  IS_TERMUX=1
fi

detect_arch() {
  case "$(uname -m)" in
    x86_64|amd64)          echo "amd64" ;;
    aarch64|arm64)         echo "arm64" ;;
    armv7l|armv8l|arm)     echo "arm" ;;
    *)                     echo "$(uname -m)" ;;
  esac
}

platform_label() {
  if [ "$IS_TERMUX" = 1 ]; then
    printf 'Termux (Android, %s)' "$(detect_arch)"
  else
    printf 'Linux (%s)' "$(detect_arch)"
  fi
}

# ---------------------------------------------------------------------------
# Server / API helpers
# ---------------------------------------------------------------------------
api_url() { printf 'http://%s' "$OLLAMA_HOST"; }

server_up() {
  curl -fsS --max-time 3 "$(api_url)/api/version" >/dev/null 2>&1
}

running_pid() {
  if [ -f "$PID_FILE" ]; then
    local pid; pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      printf '%s' "$pid"; return 0
    fi
  fi
  return 1
}

ensure_ollama() {
  have ollama || die "Ollama isn't installed yet. Run: ${C_BOLD}fabmyth setup${C_RESET}"
}

ensure_server() {
  ensure_ollama
  if server_up; then return 0; fi
  info "Ollama server isn't responding — starting it…"
  cmd_start
  local i
  for i in $(seq 1 30); do
    server_up && { ok "Server is up."; return 0; }
    sleep 1
  done
  die "Server did not come up. Check the log: $LOG_FILE"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_setup() {
  info "Setting up Ollama for: $(platform_label)"

  if have ollama; then
    ok "Ollama is already installed ($(ollama --version 2>/dev/null | head -1))."
    return 0
  fi

  if [ "$IS_TERMUX" = 1 ]; then
    setup_termux
  else
    setup_linux
  fi
}

setup_termux() {
  info "Termux detected. Installing via pkg…"
  if ! have pkg; then
    die "This looks like Termux but 'pkg' is missing. Install Termux from F-Droid."
  fi
  # Termux keeps Ollama in its repos on most modern installs.
  pkg update -y || warn "pkg update reported an issue — continuing."
  if pkg install -y ollama; then
    ok "Ollama installed via pkg."
  else
    warn "'pkg install ollama' failed. Falling back to a proot-distro guide."
    cat <<'EOF'

  Your Termux repo doesn't have an Ollama package. The reliable path is a
  small Linux distro inside Termux via proot-distro:

    pkg install -y proot-distro
    proot-distro install debian
    proot-distro login debian -- bash -c \
      'curl -fsSL https://ollama.com/install.sh | sh'

  Then run this helper from *inside* the debian shell:
    proot-distro login debian
    fabmyth start

  See docs/TERMUX.md for the full walkthrough.
EOF
    return 1
  fi
}

setup_linux() {
  local arch; arch="$(detect_arch)"
  info "Installing Ollama for Linux/$arch…"

  # Preferred: official installer (handles systemd + PATH when root is available).
  if have curl; then
    if [ "$(id -u)" = "0" ] || have sudo; then
      info "Using the official Ollama install script."
      curl -fsSL https://ollama.com/install.sh | sh && { ok "Ollama installed."; return 0; }
      warn "Official installer failed — trying a userspace binary install."
    fi
    install_binary_userspace "$arch" && return 0
  fi
  die "Couldn't install Ollama automatically. See https://ollama.com/download"
}

# Root-free install: drop the static binary into ~/.local/bin
install_binary_userspace() {
  local arch="$1"
  local dest="$HOME/.local/bin"
  local url="https://ollama.com/download/ollama-linux-${arch}.tgz"
  mkdir -p "$dest"
  info "Downloading userspace binary → $dest"
  local tmp; tmp="$(mktemp -d)"
  if curl -fsSL "$url" -o "$tmp/ollama.tgz"; then
    tar -xzf "$tmp/ollama.tgz" -C "$tmp" 2>/dev/null || true
    if [ -f "$tmp/bin/ollama" ]; then
      install -m 0755 "$tmp/bin/ollama" "$dest/ollama"
    elif [ -f "$tmp/ollama" ]; then
      install -m 0755 "$tmp/ollama" "$dest/ollama"
    else
      rm -rf "$tmp"; return 1
    fi
    rm -rf "$tmp"
    ok "Installed to $dest/ollama"
    case ":$PATH:" in
      *":$dest:"*) : ;;
      *) warn "Add this to your shell profile:  export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
    esac
    return 0
  fi
  rm -rf "$tmp"; return 1
}

cmd_start() {
  ensure_ollama
  if running_pid >/dev/null; then
    ok "Server already running (pid $(running_pid))."
    return 0
  fi
  if server_up; then
    ok "An Ollama server is already listening on $OLLAMA_HOST."
    return 0
  fi
  info "Starting Ollama server (host $OLLAMA_HOST)…"
  : > "$LOG_FILE"
  # Run in its own session/process group so `stop` can reap the whole tree,
  # even when the server spawns child processes.
  if have setsid; then
    setsid ollama serve >>"$LOG_FILE" 2>&1 &
  else
    nohup ollama serve >>"$LOG_FILE" 2>&1 &
  fi
  echo $! > "$PID_FILE"
  local i
  for i in $(seq 1 30); do
    server_up && { ok "Server ready → $(api_url)  (logs: $LOG_FILE)"; return 0; }
    sleep 1
  done
  err "Server started (pid $(cat "$PID_FILE")) but isn't answering yet. Tail the log:"
  say "  tail -f $LOG_FILE"
  return 1
}

cmd_stop() {
  local pid
  if pid="$(running_pid)"; then
    info "Stopping Ollama server (pid $pid)…"
    # Try to terminate the whole process group (pid is the group leader when
    # started with setsid); fall back to the single pid.
    kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    sleep 1
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
    ok "Stopped."
  else
    rm -f "$PID_FILE"
    warn "No server was started by fabmyth."
    if server_up; then
      warn "But something is still listening on $OLLAMA_HOST (started outside fabmyth)."
    fi
  fi
}

cmd_status() {
  info "FaB-Myth-Ai status"
  say "  Platform : $(platform_label)"
  say "  Host     : $OLLAMA_HOST"
  if have ollama; then
    say "  Ollama   : ${C_GREEN}installed${C_RESET} ($(ollama --version 2>/dev/null | head -1))"
  else
    say "  Ollama   : ${C_RED}not installed${C_RESET}  (run: fabmyth setup)"
  fi
  if server_up; then
    local ver; ver="$(curl -fsS --max-time 3 "$(api_url)/api/version" 2>/dev/null | jq -r '.version' 2>/dev/null || echo '?')"
    say "  Server   : ${C_GREEN}up${C_RESET} (api v$ver)"
  else
    say "  Server   : ${C_YELLOW}down${C_RESET}  (run: fabmyth start)"
  fi
  local pid
  if pid="$(running_pid)"; then
    say "  PID      : $pid  (managed by fabmyth)"
  fi
}

cmd_pull() {
  [ $# -ge 1 ] || die "Usage: fabmyth pull <model>   (e.g. fabmyth pull llama3.2:1b)"
  ensure_server
  info "Downloading '$1' — this can take a while on mobile data."
  ollama pull "$@"
}

cmd_run() {
  [ $# -ge 1 ] || die "Usage: fabmyth run <model> [prompt]"
  ensure_server
  local model="$1"; shift
  if ! ollama list 2>/dev/null | awk 'NR>1{print $1}' | grep -qx "$model"; then
    warn "'$model' isn't installed locally. Pulling it first…"
    ollama pull "$model"
  fi
  ollama run "$model" "$@"
}

cmd_chat() {
  ensure_server
  local models
  models="$(ollama list 2>/dev/null | awk 'NR>1{print $1}')"
  if [ -z "$models" ]; then
    warn "No models installed yet."
    say  "Try:  fabmyth search      then   fabmyth pull <model>"
    return 1
  fi
  info "Installed models:"
  local i=1; local arr=()
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    arr+=("$m"); printf '  %s%2d%s  %s\n' "$C_BOLD" "$i" "$C_RESET" "$m"; i=$((i+1))
  done <<< "$models"
  printf '%sPick a number (or type a model name):%s ' "$C_CYAN" "$C_RESET"
  read -r choice
  local model
  if printf '%s' "$choice" | grep -qE '^[0-9]+$' && [ "$choice" -ge 1 ] && [ "$choice" -le "${#arr[@]}" ]; then
    model="${arr[$((choice-1))]}"
  else
    model="$choice"
  fi
  [ -n "$model" ] || die "No model selected."
  info "Starting chat with $model  (type /bye to quit)"
  ollama run "$model"
}

# ---------------------------------------------------------------------------
# Termux AgenticOS — let the model take actions on the device, with consent
# ---------------------------------------------------------------------------
cmd_agent() {
  [ $# -ge 1 ] || die "Usage: fabmyth agent <model> [initial task]   (e.g. fabmyth agent llama3.2:3b \"list my downloads\")"
  ensure_server
  local model="$1"; shift

  local PYBIN
  if have python3; then PYBIN=python3
  elif have python; then PYBIN=python
  else die "AgenticOS needs Python. Install it:  pkg install python  (Termux)  |  apt install python3 (Debian)"
  fi

  if ! ollama list 2>/dev/null | awk 'NR>1{print $1}' | grep -qx "$model"; then
    warn "'$model' isn't installed. Pulling it first…"
    ollama pull "$model" || die "Could not pull $model"
  fi

  # Write the embedded agent to disk so its stdin stays connected to the
  # terminal (needed for the per-action consent prompts).
  local agent_py="$FABMYTH_HOME/agentic.py"
  cat > "$agent_py" <<'PYEOF'
#!/usr/bin/env python3
"""FaB-Myth AgenticOS: a consent-gated agent loop over any Ollama model.

The model can act on the device by emitting fenced blocks tagged 'fabmyth-*'.
Only those tagged blocks ever run, and only after the user approves each one.
Files it creates land under  <storage>/FabMyth/<ModelName>/ .
"""
import os, sys, re, json, subprocess, tempfile
import urllib.request, urllib.error

HOST = os.environ.get("OLLAMA_HOST", "127.0.0.1:11434")
BASE = HOST if HOST.startswith("http") else "http://" + HOST
PYBIN = os.environ.get("FABMYTH_PY", "python3")

TTY = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
def _c(x): return x if TTY else ""
R=_c("\033[0m"); B=_c("\033[1m"); DIM=_c("\033[2m")
RED=_c("\033[31m"); GRN=_c("\033[32m"); YEL=_c("\033[33m"); CYN=_c("\033[36m"); MAG=_c("\033[35m")

MODEL = sys.argv[1] if len(sys.argv) > 1 else "llama3.2:3b"
INIT  = " ".join(sys.argv[2:]).strip()

def safe_name(m): return re.sub(r"[^A-Za-z0-9._-]", "_", m)

def storage_base():
    env = os.environ.get("FABMYTH_STORAGE")
    if env: return env
    for p in ("/sdcard", "/storage/emulated/0"):
        if os.path.isdir(p): return p
    return os.path.expanduser("~")

WORKSPACE = os.path.join(storage_base(), "FabMyth", safe_name(MODEL))
try:
    os.makedirs(WORKSPACE, exist_ok=True)
except PermissionError:
    sys.stderr.write(
        "Cannot create %s\nOn Termux, run:  termux-setup-storage  (then grant "
        "storage permission), or set FABMYTH_STORAGE to a writable path.\n" % WORKSPACE)
    sys.exit(1)

SYSTEM = (
    "You are FaB-Myth AgenticOS, an AI agent running on the user's device via "
    "Termux/Linux. You can take real actions by emitting fenced code blocks with "
    "one of these exact info tags. ONLY blocks with a 'fabmyth-' tag are executed, "
    "and the user must approve every one before it runs.\n\n"
    "Run a shell command:\n```fabmyth-sh\nls -la\n```\n\n"
    "Run Python:\n```fabmyth-py\nprint('hi')\n```\n\n"
    "Run JavaScript (Node.js):\n```fabmyth-js\nconsole.log('hi')\n```\n\n"
    "Save a file (relative path, stored in your workspace):\n"
    "```fabmyth-save notes.txt\nfile contents\n```\n\n"
    "Rules:\n"
    "- Emit a fabmyth- block ONLY when you actually want to run or save something; "
    "otherwise just reply in plain text.\n"
    "- After each action you receive its output in a message starting with [fabmyth]. "
    "Use it to decide the next step.\n"
    "- Your working directory IS the workspace folder; files you create stay there.\n"
    "- Prefer small, safe commands. Never try to bypass the approval step.\n"
    "- When the task is done, give a short plain-text summary with no action block.\n"
    "Your workspace: " + WORKSPACE
)

ACTION_RE = re.compile(r"```fabmyth-([A-Za-z]+)[ \t]*([^\n]*)\n(.*?)```", re.DOTALL)
SYNONYMS = {"sh":"shell","shell":"shell","bash":"shell",
            "py":"python","python":"python",
            "js":"js","javascript":"js","node":"js",
            "save":"save","file":"save","write":"save"}

def parse_actions(text):
    out = []
    for m in ACTION_RE.finditer(text):
        kind = SYNONYMS.get(m.group(1).lower().strip())
        if kind:
            out.append((kind, m.group(2).strip(), m.group(3)))
    return out

MAXOUT = 6000
def clip(s):
    return s if len(s) <= MAXOUT else s[:MAXOUT] + "\n...[truncated %d chars]" % (len(s) - MAXOUT)

def run_shell(body):
    try:
        p = subprocess.run(["bash","-c",body], cwd=WORKSPACE, capture_output=True,
                           text=True, timeout=300)
    except subprocess.TimeoutExpired:
        return 124, "timed out after 300s"
    out = p.stdout or ""
    if p.stderr: out += "\n[stderr]\n" + p.stderr
    return p.returncode, clip(out.strip())

def run_code(kind, body):
    suffix = ".py" if kind == "python" else ".js"
    interp = [PYBIN] if kind == "python" else ["node"]
    fd, path = tempfile.mkstemp(suffix=suffix, prefix="fabmyth_")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(body)
        try:
            p = subprocess.run(interp + [path], cwd=WORKSPACE, capture_output=True,
                               text=True, timeout=300)
        except FileNotFoundError:
            pkg = "python" if kind == "python" else "nodejs"
            return 127, "%s is not installed. Install it:  pkg install %s" % (interp[0], pkg)
        except subprocess.TimeoutExpired:
            return 124, "timed out after 300s"
        out = p.stdout or ""
        if p.stderr: out += "\n[stderr]\n" + p.stderr
        return p.returncode, clip(out.strip())
    finally:
        try: os.remove(path)
        except OSError: pass

def save_file(arg, body):
    name = arg.strip().strip('"').strip("'")
    if not name:
        return False, "no filename given"
    if os.path.isabs(name) or ".." in name.split("/"):
        return False, "refused unsafe path: " + name
    dest = os.path.realpath(os.path.join(WORKSPACE, name))
    root = os.path.realpath(WORKSPACE)
    if not (dest == root or dest.startswith(root + os.sep)):
        return False, "refused path outside workspace"
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    with open(dest, "w") as f:
        f.write(body)
    return True, dest

ALLOW_ALL = False
LABEL = {"shell":"RUN SHELL","python":"RUN PYTHON","js":"RUN JAVASCRIPT","save":"SAVE FILE"}

def consent(kind, arg, body):
    global ALLOW_ALL
    print()
    print("%s>> %s %s%s" % (YEL + B, LABEL[kind], arg if kind == "save" else "", R))
    print(DIM + "-" * 52 + R)
    print(body.rstrip("\n"))
    print(DIM + "-" * 52 + R)
    if ALLOW_ALL:
        print(GRN + "[auto-approved]" + R)
        return True
    try:
        ans = input("%sApprove? [y]es / [N]o / [a]ll this session / [q]uit: %s" % (CYN, R)).strip().lower()
    except EOFError:
        return False
    if ans == "q":
        print("Quitting AgenticOS.")
        sys.exit(0)
    if ans == "a":
        ALLOW_ALL = True
        return True
    return ans in ("y", "yes")

def chat(messages):
    data = json.dumps({"model": MODEL, "messages": messages, "stream": False}).encode()
    req = urllib.request.Request(BASE + "/api/chat", data=data,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=600) as r:
        return json.loads(r.read().decode())["message"]["content"]

def main():
    print("%sFaB-Myth AgenticOS%s  model=%s" % (B + MAG, R, MODEL))
    print("  workspace : %s" % WORKSPACE)
    print("  %severy action needs your approval. Commands: /bye /reset /ws%s" % (DIM, R))
    print()

    messages = [{"role": "system", "content": SYSTEM}]
    pending = INIT or None

    while True:
        if pending is None:
            try:
                user = input("%syou>%s " % (B + CYN, R)).strip()
            except EOFError:
                print(); break
            if not user:
                continue
            if user in ("/bye", "/exit", "/quit"):
                break
            if user == "/reset":
                messages = messages[:1]; print("(history cleared)"); continue
            if user == "/ws":
                print(WORKSPACE); continue
            messages.append({"role": "user", "content": user})
        else:
            messages.append({"role": "user", "content": pending}); pending = None

        for _ in range(10):
            try:
                reply = chat(messages)
            except urllib.error.URLError as e:
                print(RED + "Cannot reach Ollama at %s: %s" % (BASE, e) + R); reply = None; break
            except Exception as e:
                print(RED + "Chat error: %s" % e + R); reply = None; break
            messages.append({"role": "assistant", "content": reply})
            print("\n%sassistant>%s %s" % (B + MAG, R, reply.strip()))
            actions = parse_actions(reply)
            if not actions:
                break
            results = []
            for kind, arg, body in actions:
                if not consent(kind, arg, body):
                    results.append("[fabmyth] %s: user declined" % kind)
                    print(YEL + "(declined)" + R)
                    continue
                if kind == "shell":
                    rc, out = run_shell(body)
                elif kind == "python":
                    rc, out = run_code("python", body)
                elif kind == "js":
                    rc, out = run_code("js", body)
                elif kind == "save":
                    ok, info = save_file(arg, body)
                    results.append("[fabmyth] save %s: %s" %
                                   (arg, "saved -> " + info if ok else "FAILED: " + info))
                    print((GRN + "saved " + info) if ok else (RED + "save failed: " + info), R)
                    continue
                results.append("[fabmyth] %s result (exit %d):\n%s" % (kind, rc, out or "(no output)"))
                print(("%s%s exit %d%s" % (GRN if rc == 0 else RED, kind, rc, R)))
                if out:
                    print(DIM + out + R)
            messages.append({"role": "user", "content": "\n\n".join(results)})
        else:
            print(YEL + "(reached the action limit for this task — tell me to continue if needed)" + R)

    print("Goodbye. Files are in: %s" % WORKSPACE)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nInterrupted.")
PYEOF

  info "Launching Termux AgenticOS with $model"
  FABMYTH_PY="$PYBIN" OLLAMA_HOST="$OLLAMA_HOST" "$PYBIN" "$agent_py" "$model" "$@"
}

# ---------------------------------------------------------------------------
# Web API — expose a model over HTTP + a one-tag embeddable chat widget.
# Chat/generate only (never runs commands, unlike AgenticOS). No API key.
# ---------------------------------------------------------------------------
cmd_web() {
  local model="" port="8777" host="0.0.0.0" url="" system=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)      port="${2:?--port needs a value}"; shift 2 ;;
      --host)      host="${2:?--host needs a value}"; shift 2 ;;
      --url)       url="${2:?--url needs a value}"; shift 2 ;;
      --system)    system="${2:?--system needs a value}"; shift 2 ;;
      --port=*)    port="${1#*=}"; shift ;;
      --host=*)    host="${1#*=}"; shift ;;
      --url=*)     url="${1#*=}"; shift ;;
      --system=*)  system="${1#*=}"; shift ;;
      -*)          die "Unknown option: $1" ;;
      *)           if [ -z "$model" ]; then model="$1"; else die "Unexpected argument: $1"; fi; shift ;;
    esac
  done
  [ -n "$model" ] || die "Usage: fabmyth web <model> [--port N] [--host H] [--url URL] [--system TEXT]"

  local PYBIN
  if have python3; then PYBIN=python3
  elif have python; then PYBIN=python
  else die "The web API needs Python. Install it:  pkg install python  |  apt install python3"
  fi

  ensure_server

  if ! ollama list 2>/dev/null | awk 'NR>1{print $1}' | grep -qx "$model"; then
    warn "'$model' isn't installed. Pulling it first…"
    ollama pull "$model" || die "Could not pull $model"
  fi

  local web_py="$FABMYTH_HOME/webapi.py"
  cat > "$web_py" <<'PYEOF'
#!/usr/bin/env python3
"""FaB-Myth Web API: expose ONE Ollama model over HTTP with an embeddable chat
widget. Paste a single <script> tag into any website -- no API key.

This endpoint is chat/generate only; it never executes commands (unlike the
AgenticOS feature).
"""
import os, sys, json, socket
import urllib.request, urllib.error
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

MODEL  = os.environ.get("FABMYTH_WEB_MODEL", "llama3.2:3b")
PORT   = int(os.environ.get("FABMYTH_WEB_PORT", "8777"))
HOST   = os.environ.get("FABMYTH_WEB_HOST", "0.0.0.0")
SYSTEM = os.environ.get("FABMYTH_WEB_SYSTEM", "").strip()
OHOST  = os.environ.get("OLLAMA_HOST", "127.0.0.1:11434")
OBASE  = OHOST if OHOST.startswith("http") else "http://" + OHOST

def guess_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80)); ip = s.getsockname()[0]; s.close()
        return ip
    except Exception:
        return "127.0.0.1"

PUBLIC_URL = os.environ.get("FABMYTH_WEB_URL", "").rstrip("/")
if not PUBLIC_URL:
    ip = guess_ip() if HOST in ("0.0.0.0", "::", "") else HOST
    PUBLIC_URL = "http://%s:%d" % (ip, PORT)

EMBED_TAG = '<script src="%s/embed.js" data-fabmyth-model="%s"></script>' % (PUBLIC_URL, MODEL)
EMBED_TAG_ESC = EMBED_TAG.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

EMBED_JS = r'''(function(){
  var cs=document.currentScript;
  if(!cs){var ss=document.getElementsByTagName('script');cs=ss[ss.length-1];}
  var base=cs.src.replace(/\/embed\.js.*$/,'');
  var model=cs.getAttribute('data-fabmyth-model')||'';
  var title=cs.getAttribute('data-fabmyth-title')||'Ask AI';
  var accent=cs.getAttribute('data-fabmyth-color')||'#4f46e5';
  var history=[];
  var css=[
   '.fabmyth-btn{position:fixed;right:20px;bottom:20px;z-index:2147483000;width:56px;height:56px;border-radius:50%;border:none;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.25);font-size:24px;color:#fff;background:'+accent+'}',
   '.fabmyth-panel{position:fixed;right:20px;bottom:88px;z-index:2147483000;width:min(360px,92vw);height:min(520px,72vh);background:#fff;color:#111;border-radius:14px;box-shadow:0 12px 40px rgba(0,0,0,.3);display:none;flex-direction:column;overflow:hidden;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}',
   '.fabmyth-panel.open{display:flex}',
   '.fabmyth-head{background:'+accent+';color:#fff;padding:12px 14px;font-weight:600;display:flex;justify-content:space-between;align-items:center}',
   '.fabmyth-x{cursor:pointer;background:none;border:none;color:#fff;font-size:20px;line-height:1}',
   '.fabmyth-msgs{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px;background:#f7f7f8}',
   '.fabmyth-m{max-width:82%;padding:8px 11px;border-radius:12px;line-height:1.4;white-space:pre-wrap;word-wrap:break-word;font-size:14px}',
   '.fabmyth-u{align-self:flex-end;background:'+accent+';color:#fff;border-bottom-right-radius:4px}',
   '.fabmyth-a{align-self:flex-start;background:#fff;color:#111;border:1px solid #e5e7eb;border-bottom-left-radius:4px}',
   '.fabmyth-foot{display:flex;gap:6px;padding:10px;border-top:1px solid #eee;background:#fff}',
   '.fabmyth-in{flex:1;border:1px solid #d1d5db;border-radius:10px;padding:9px 11px;font-size:14px;outline:none}',
   '.fabmyth-send{border:none;background:'+accent+';color:#fff;border-radius:10px;padding:0 14px;cursor:pointer;font-size:14px}',
   '.fabmyth-cred{font-size:11px;color:#9ca3af;text-align:center;padding:4px}',
   '@media (prefers-color-scheme:dark){.fabmyth-panel{background:#1f2023;color:#eee}.fabmyth-msgs{background:#17181a}.fabmyth-a{background:#26272b;color:#eee;border-color:#3a3b40}.fabmyth-foot{background:#1f2023;border-color:#2c2d31}.fabmyth-in{background:#26272b;color:#eee;border-color:#3a3b40}}'
  ].join('');
  var st=document.createElement('style');st.textContent=css;document.head.appendChild(st);
  var btn=document.createElement('button');btn.className='fabmyth-btn';btn.innerHTML='&#128172;';btn.title=title;
  var panel=document.createElement('div');panel.className='fabmyth-panel';
  panel.innerHTML='<div class="fabmyth-head"><span></span><button class="fabmyth-x" aria-label="close">&times;</button></div>'+
    '<div class="fabmyth-msgs"></div>'+
    '<div class="fabmyth-foot"><input class="fabmyth-in" placeholder="Type a message..."><button class="fabmyth-send">Send</button></div>'+
    '<div class="fabmyth-cred">powered by FaB-Myth-Ai</div>';
  document.body.appendChild(btn);document.body.appendChild(panel);
  panel.querySelector('.fabmyth-head span').textContent=title;
  var msgs=panel.querySelector('.fabmyth-msgs'),input=panel.querySelector('.fabmyth-in'),sendb=panel.querySelector('.fabmyth-send');
  function add(role,text){var d=document.createElement('div');d.className='fabmyth-m '+(role==='user'?'fabmyth-u':'fabmyth-a');d.textContent=text;msgs.appendChild(d);msgs.scrollTop=msgs.scrollHeight;return d;}
  function toggle(open){panel.classList.toggle('open',open);if(open)input.focus();}
  btn.onclick=function(){toggle(!panel.classList.contains('open'));};
  panel.querySelector('.fabmyth-x').onclick=function(){toggle(false);};
  var busy=false;
  function send(){
    var text=(input.value||'').trim();if(!text||busy)return;
    input.value='';add('user',text);history.push({role:'user',content:text});
    busy=true;sendb.disabled=true;var typing=add('assistant','...');
    fetch(base+'/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({message:text,history:history.slice(0,-1),model:model})})
     .then(function(r){return r.json();})
     .then(function(j){var reply=j.reply||('[error] '+(j.error||'no response'));typing.textContent=reply;history.push({role:'assistant',content:reply});})
     .catch(function(e){typing.textContent='[network error] '+e;})
     .then(function(){busy=false;sendb.disabled=false;input.focus();});
  }
  sendb.onclick=send;
  input.addEventListener('keydown',function(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();send();}});
})();'''

DEMO_TMPL = '''<!doctype html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>FaB-Myth Web API - __MODEL__</title>
<style>body{font-family:system-ui,-apple-system,sans-serif;max-width:720px;margin:40px auto;padding:0 16px;line-height:1.55;color:#111}h1{margin-bottom:2px}code,pre{background:#f3f4f6;border-radius:6px}pre{padding:14px;overflow:auto;white-space:pre-wrap;word-break:break-all}small{color:#666}button.copy{margin-top:6px;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;background:#fff;cursor:pointer}@media(prefers-color-scheme:dark){body{background:#111;color:#eee}code,pre{background:#1e1e22}button.copy{background:#26272b;color:#eee;border-color:#3a3b40}}</style>
</head><body>
<h1>FaB-Myth Web API</h1>
<small>Serving model <b>__MODEL__</b> &mdash; chat only, no commands, no API key.</small>
<h2>Add it to your website</h2>
<p>Paste this one tag into your HTML, just before <code>&lt;/body&gt;</code>:</p>
<pre id="tag">__TAGESC__</pre>
<button class="copy" onclick="navigator.clipboard.writeText(document.getElementById('tag').textContent);this.textContent='Copied!'">Copy tag</button>
<h2>Live preview</h2>
<p>The chat bubble in the bottom-right corner of this page is the real widget, talking to your model.</p>
<p><small>Endpoint: <code>POST __URL__/api/chat</code> &middot; health: <code>__URL__/health</code></small></p>
__TAG__
</body></html>'''
DEMO_HTML = (DEMO_TMPL.replace("__MODEL__", MODEL)
                      .replace("__URL__", PUBLIC_URL)
                      .replace("__TAGESC__", EMBED_TAG_ESC)
                      .replace("__TAG__", EMBED_TAG))

def ollama_chat(messages):
    data = json.dumps({"model": MODEL, "messages": messages, "stream": False}).encode()
    req = urllib.request.Request(OBASE + "/api/chat", data=data,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=600) as r:
        return json.loads(r.read().decode())["message"]["content"]

class Handler(BaseHTTPRequestHandler):
    def _cors(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "POST, GET, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
    def _send(self, code, body, ctype="application/json"):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self._cors()
        self.end_headers()
        self.wfile.write(body)
    def do_OPTIONS(self):
        self.send_response(204); self._cors(); self.end_headers()
    def do_GET(self):
        p = self.path.split("?")[0]
        if p == "/embed.js":
            self._send(200, EMBED_JS, "application/javascript; charset=utf-8")
        elif p in ("/", "/index.html", "/demo"):
            self._send(200, DEMO_HTML, "text/html; charset=utf-8")
        elif p == "/health":
            self._send(200, json.dumps({"ok": True, "model": MODEL}))
        else:
            self._send(404, json.dumps({"error": "not found"}))
    def do_POST(self):
        if self.path.split("?")[0] != "/api/chat":
            self._send(404, json.dumps({"error": "not found"})); return
        try:
            ln = int(self.headers.get("Content-Length", 0))
            payload = json.loads(self.rfile.read(ln).decode() or "{}")
        except Exception:
            self._send(400, json.dumps({"error": "invalid JSON"})); return
        messages = []
        if SYSTEM:
            messages.append({"role": "system", "content": SYSTEM})
        hist = payload.get("history") or payload.get("messages") or []
        if isinstance(hist, list):
            for m in hist[-20:]:
                if isinstance(m, dict) and m.get("role") in ("user", "assistant") and m.get("content"):
                    messages.append({"role": m["role"], "content": str(m["content"])[:8000]})
        msg = payload.get("message")
        if msg:
            messages.append({"role": "user", "content": str(msg)[:8000]})
        if not messages or messages[-1]["role"] != "user":
            self._send(400, json.dumps({"error": "no user message provided"})); return
        try:
            reply = ollama_chat(messages)
        except urllib.error.URLError as e:
            self._send(502, json.dumps({"error": "ollama unreachable: %s" % e})); return
        except Exception as e:
            self._send(502, json.dumps({"error": str(e)})); return
        self._send(200, json.dumps({"reply": reply, "model": MODEL}))
    def log_message(self, *a):
        pass

def main():
    print("FaB-Myth Web API")
    print("  model      : %s" % MODEL)
    print("  binding    : %s:%d" % (HOST, PORT))
    print("  public url : %s" % PUBLIC_URL)
    print()
    print("Paste this ONE tag into your website (no API key needed):")
    print()
    print("    " + EMBED_TAG)
    print()
    print("Preview / copy page: %s" % PUBLIC_URL)
    print("Chat-only API (never runs commands). Press Ctrl-C to stop.")
    if HOST in ("0.0.0.0", "::", ""):
        print("NOTE: bound to all interfaces -- anyone who can reach this host can use")
        print("      the model. For a public website, front it with a tunnel/HTTPS and")
        print("      pass --url <your-https-url>.")
    print()
    try:
        ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")
    except OSError as e:
        sys.stderr.write("Could not bind %s:%d -- %s\n" % (HOST, PORT, e)); sys.exit(1)

if __name__ == "__main__":
    main()
PYEOF

  info "Starting FaB-Myth Web API for $model"
  FABMYTH_WEB_MODEL="$model" FABMYTH_WEB_PORT="$port" FABMYTH_WEB_HOST="$host" \
  FABMYTH_WEB_URL="$url" FABMYTH_WEB_SYSTEM="$system" OLLAMA_HOST="$OLLAMA_HOST" \
  "$PYBIN" "$web_py"
}

# ---------------------------------------------------------------------------
# Memory — persistent, per-model conversation history.
# `remember` is a chat that recalls past sessions; `memory` manages the store.
# Each model has its OWN memory file, keyed by model name (tag included).
# ---------------------------------------------------------------------------
_write_memory_py() {
  local mem_py="$FABMYTH_HOME/memory.py"
  cat > "$mem_py" <<'PYEOF'
#!/usr/bin/env python3
"""FaB-Myth memory: persistent per-model conversation history.

Modes (argv[1]):
  chat  <model> [initial message]   interactive chat that remembers past runs
  list                              list models that have saved memory
  show  <model>                     print a model's stored conversation
  clear <model> | clear --all       erase memory for one model / all models

Each model's history lives in its OWN file, so models never share memory.
"""
import os, sys, re, json, time
import urllib.request, urllib.error

HOST  = os.environ.get("OLLAMA_HOST", "127.0.0.1:11434")
BASE  = HOST if HOST.startswith("http") else "http://" + HOST
PYBIN = os.environ.get("FABMYTH_PY", "python3")
HOME  = os.environ.get("FABMYTH_HOME", os.path.expanduser("~/.fabmyth"))
MEM_DIR = os.environ.get("FABMYTH_MEMORY_DIR", os.path.join(HOME, "memory"))
os.makedirs(MEM_DIR, exist_ok=True)

TTY = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
def _c(x): return x if TTY else ""
R=_c("\033[0m"); B=_c("\033[1m"); DIM=_c("\033[2m")
GRN=_c("\033[32m"); YEL=_c("\033[33m"); CYN=_c("\033[36m"); MAG=_c("\033[35m"); RED=_c("\033[31m")

WINDOW = int(os.environ.get("FABMYTH_MEMORY_WINDOW", "40"))   # msgs sent as context
SYSTEM = os.environ.get("FABMYTH_MEMORY_SYSTEM",
    "You are a helpful assistant with long-term memory of this ongoing "
    "conversation. Use what the user told you earlier when it is relevant.")

def safe(m): return re.sub(r"[^A-Za-z0-9._-]", "_", m)
def mem_file(model): return os.path.join(MEM_DIR, safe(model) + ".json")

def load(model):
    try:
        with open(mem_file(model)) as f:
            return json.load(f).get("messages", [])
    except Exception:
        return []

def save(model, messages):
    path = mem_file(model)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"model": model, "updated": time.time(), "messages": messages}, f)
    os.replace(tmp, path)

def api_chat(messages):
    payload = [{"role": m["role"], "content": m["content"]} for m in messages]
    data = json.dumps({"model": MODEL, "messages": payload, "stream": False}).encode()
    req = urllib.request.Request(BASE + "/api/chat", data=data,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=600) as r:
        return json.loads(r.read().decode())["message"]["content"]

def do_chat():
    history = load(MODEL)
    turns = sum(1 for m in history if m["role"] == "user")
    print("%sFaB-Myth Memory Chat%s  model=%s" % (B + MAG, R, MODEL))
    print("  memory file : %s" % mem_file(MODEL))
    if history:
        print("  %sremembering %d earlier message(s) across past sessions%s" % (DIM, len(history), R))
        last_a = next((m["content"] for m in reversed(history) if m["role"] == "assistant"), "")
        if last_a:
            snippet = last_a.strip().replace("\n", " ")
            print("  %slast time I said: %s%s" % (DIM, (snippet[:70] + "...") if len(snippet) > 70 else snippet, R))
    else:
        print("  %sno memory yet — starting fresh%s" % (DIM, R))
    print("  %scommands: /bye  /forget (wipe this model's memory)  /memory (stats)%s" % (DIM, R))
    print()

    pending = INIT or None
    while True:
        if pending is None:
            try:
                user = input("%syou>%s " % (B + CYN, R)).strip()
            except EOFError:
                print(); break
            if not user:
                continue
            if user in ("/bye", "/exit", "/quit"):
                break
            if user == "/forget":
                try: os.remove(mem_file(MODEL))
                except OSError: pass
                history = []
                print(YEL + "(memory for %s wiped)" % MODEL + R); continue
            if user == "/memory":
                t = sum(1 for m in history if m["role"] == "user")
                print("%s%d messages stored (%d of your turns) in %s%s" % (DIM, len(history), t, mem_file(MODEL), R)); continue
            msg = user
        else:
            msg = pending; pending = None

        history.append({"role": "user", "content": msg, "ts": time.time()})
        context = [{"role": "system", "content": SYSTEM}] + history[-WINDOW:]
        try:
            reply = api_chat(context)
        except urllib.error.URLError as e:
            print(RED + "Cannot reach Ollama at %s: %s" % (BASE, e) + R)
            history.pop()  # don't persist a turn we couldn't answer
            break
        except Exception as e:
            print(RED + "Chat error: %s" % e + R); history.pop(); break
        history.append({"role": "assistant", "content": reply, "ts": time.time()})
        save(MODEL, history)
        print("\n%sassistant>%s %s\n" % (B + MAG, R, reply.strip()))

    print("Memory saved to %s" % mem_file(MODEL))

def do_list():
    files = sorted(f for f in os.listdir(MEM_DIR) if f.endswith(".json"))
    if not files:
        print("No saved memories yet. Start one with:  fabmyth remember <model>")
        return
    print("%sSaved model memories%s  (%s)" % (B, R, MEM_DIR))
    for f in files:
        path = os.path.join(MEM_DIR, f)
        try:
            with open(path) as fh: d = json.load(fh)
            msgs = d.get("messages", [])
            model = d.get("model", f[:-5])
            turns = sum(1 for m in msgs if m.get("role") == "user")
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(d.get("updated", 0)))
            kb = os.path.getsize(path) / 1024.0
            print("  %s%-32s%s %3d turns  %6.1f KB  last %s" % (B, model, R, turns, kb, when))
        except Exception:
            print("  %s (unreadable)" % f)

def do_show():
    msgs = load(MODEL)
    if not msgs:
        print("No memory stored for %s." % MODEL); return
    print("%sConversation memory for %s%s" % (B, MODEL, R))
    for m in msgs:
        who = "you" if m.get("role") == "user" else "ai "
        col = CYN if m.get("role") == "user" else MAG
        print("%s%s>%s %s" % (col, who, R, str(m.get("content", "")).strip()))

def do_clear():
    if MODEL == "--all":
        n = 0
        for f in os.listdir(MEM_DIR):
            if f.endswith(".json"):
                try: os.remove(os.path.join(MEM_DIR, f)); n += 1
                except OSError: pass
        print("Cleared %d model memor%s." % (n, "y" if n == 1 else "ies")); return
    path = mem_file(MODEL)
    if os.path.exists(path):
        os.remove(path); print("Cleared memory for %s." % MODEL)
    else:
        print("No memory to clear for %s." % MODEL)

MODE  = sys.argv[1] if len(sys.argv) > 1 else "list"
MODEL = sys.argv[2] if len(sys.argv) > 2 else ""
INIT  = " ".join(sys.argv[3:]).strip()

if __name__ == "__main__":
    try:
        if   MODE == "chat":  do_chat()
        elif MODE == "list":  do_list()
        elif MODE == "show":  do_show()
        elif MODE == "clear": do_clear()
        else: sys.stderr.write("unknown memory mode: %s\n" % MODE); sys.exit(2)
    except KeyboardInterrupt:
        print("\nInterrupted.")
PYEOF
}

cmd_remember() {
  [ $# -ge 1 ] || die "Usage: fabmyth remember <model> [message]   (chat that remembers past sessions)"
  ensure_server
  local model="$1"; shift
  local PYBIN
  if have python3; then PYBIN=python3
  elif have python; then PYBIN=python
  else die "Memory needs Python. Install it:  pkg install python  |  apt install python3"
  fi
  if ! ollama list 2>/dev/null | awk 'NR>1{print $1}' | grep -qx "$model"; then
    warn "'$model' isn't installed. Pulling it first…"
    ollama pull "$model" || die "Could not pull $model"
  fi
  _write_memory_py
  info "Memory chat with $model  (each model has its own memory)"
  FABMYTH_PY="$PYBIN" FABMYTH_HOME="$FABMYTH_HOME" OLLAMA_HOST="$OLLAMA_HOST" \
    "$PYBIN" "$FABMYTH_HOME/memory.py" chat "$model" "$@"
}

cmd_memory() {
  local PYBIN
  if have python3; then PYBIN=python3
  elif have python; then PYBIN=python
  else die "Memory needs Python. Install it:  pkg install python  |  apt install python3"
  fi
  _write_memory_py
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls)     FABMYTH_HOME="$FABMYTH_HOME" "$PYBIN" "$FABMYTH_HOME/memory.py" list ;;
    show)        [ $# -ge 1 ] || die "Usage: fabmyth memory show <model>"
                 FABMYTH_HOME="$FABMYTH_HOME" "$PYBIN" "$FABMYTH_HOME/memory.py" show "$1" ;;
    clear|rm)    [ $# -ge 1 ] || die "Usage: fabmyth memory clear <model>|--all"
                 FABMYTH_HOME="$FABMYTH_HOME" "$PYBIN" "$FABMYTH_HOME/memory.py" clear "$1" ;;
    where|dir)   say "$FABMYTH_HOME/memory" ;;
    *)           die "Usage: fabmyth memory <list|show <model>|clear <model>|--all|where>" ;;
  esac
}

# ---------------------------------------------------------------------------
# Image generation — wraps Ollama's (experimental) text-to-image support.
# Models like x/z-image-turbo:fp8 (13GB) / :bf16 (33GB). NOTE: as of 2026
# Ollama image generation is macOS-only; Linux/Termux support is pending.
# ---------------------------------------------------------------------------
cmd_image() {
  ensure_server

  # First token is the model only if it looks like a bare model ref (no spaces);
  # otherwise everything is the prompt and we use a default image model.
  local model
  if [ $# -ge 2 ] && printf '%s' "$1" | grep -qE '^[A-Za-z0-9._/-]+(:[A-Za-z0-9._-]+)?$'; then
    model="$1"; shift
  else
    model="${FABMYTH_IMAGE_MODEL:-x/z-image-turbo:fp8}"
  fi
  local prompt="$*"
  [ -n "$prompt" ] || die "Usage: fabmyth image [model] \"<prompt>\"   (e.g. fabmyth image \"a red fox in snow\")"

  # Platform reality check (don't hard-block — the situation is evolving).
  if [ "$(uname -s)" != "Darwin" ]; then
    warn "Ollama image generation is currently macOS-only (experimental)."
    warn "On $(platform_label) this may fail until Ollama ships Linux support — trying anyway."
  fi

  # These models are big; never auto-pull tens of GB. Ask the user to opt in.
  if ! ollama list 2>/dev/null | awk 'NR>1{print $1}' | grep -qx "$model"; then
    err "'$model' isn't installed."
    say "  Image models are large (x/z-image-turbo:fp8 ~13GB, :bf16 ~33GB)."
    say "  Download it explicitly when you're ready:"
    say "     ${C_BOLD}fabmyth pull $model${C_RESET}"
    return 1
  fi

  local outdir="${FABMYTH_IMAGE_DIR:-$PWD}"
  mkdir -p "$outdir" 2>/dev/null || die "Can't write to output dir: $outdir"

  info "Generating with $model → $outdir"
  say  "  prompt: $prompt"

  # Ollama saves generated images into the working directory; run there and
  # diff the listing to report exactly what was created.
  local before after
  before="$(ls -1 "$outdir" 2>/dev/null | sort)"
  ( cd "$outdir" && ollama run "$model" "$prompt" )
  local rc=$?
  after="$(ls -1 "$outdir" 2>/dev/null | sort)"

  local newfiles
  newfiles="$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") \
              | grep -iE '\.(png|jpg|jpeg|webp)$' || true)"
  if [ -n "$newfiles" ]; then
    ok "Created:"
    printf '%s\n' "$newfiles" | while IFS= read -r f; do [ -n "$f" ] && say "  $outdir/$f"; done
  elif [ "$rc" != 0 ]; then
    err "Image generation failed (exit $rc)."
    say "  If you're on Linux/Termux, Ollama's image support likely isn't available yet."
  else
    warn "No new image files detected in $outdir."
    say  "  The model may have printed output inline, or saved elsewhere — check above."
  fi
  return "$rc"
}

# ---------------------------------------------------------------------------
# Image host — run an image model on ONE machine and let others generate over
# HTTP (no per-person download). One <script> tag embeds it on a website.
# The host still needs the weights once; image gen is macOS-only for now.
# ---------------------------------------------------------------------------
cmd_image_web() {
  ensure_server
  local model="" port="8778" host="0.0.0.0" url=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)   port="${2:?--port needs a value}"; shift 2 ;;
      --host)   host="${2:?--host needs a value}"; shift 2 ;;
      --url)    url="${2:?--url needs a value}"; shift 2 ;;
      --port=*) port="${1#*=}"; shift ;;
      --host=*) host="${1#*=}"; shift ;;
      --url=*)  url="${1#*=}"; shift ;;
      -*)       die "Unknown option: $1" ;;
      *)        if [ -z "$model" ]; then model="$1"; else die "Unexpected argument: $1"; fi; shift ;;
    esac
  done
  [ -n "$model" ] || model="${FABMYTH_IMAGE_MODEL:-x/z-image-turbo:fp8}"

  local PYBIN
  if have python3; then PYBIN=python3
  elif have python; then PYBIN=python
  else die "The image host needs Python. Install it:  pkg install python  |  apt install python3"
  fi

  if ! ollama list 2>/dev/null | awk 'NR>1{print $1}' | grep -qx "$model"; then
    err "'$model' isn't installed on this host."
    say "  Image models are large — download it once on this machine:"
    say "     ${C_BOLD}fabmyth pull $model${C_RESET}"
    return 1
  fi

  if [ "$(uname -s)" != "Darwin" ]; then
    warn "Ollama image generation is macOS-only for now; on $(platform_label) generation"
    warn "may fail until Ollama ships Linux support. The server will still start."
  fi

  local iweb_py="$FABMYTH_HOME/imageweb.py"
  cat > "$iweb_py" <<'PYEOF'
#!/usr/bin/env python3
"""FaB-Myth Image Host: run ONE image model and serve generation over HTTP so
others don't each download the weights. One <script> tag embeds it on a site.

Generation shells out to `ollama run <model> "<prompt>"` in a temp dir and
returns the produced image, so it works regardless of the experimental image
HTTP API's exact shape. No API key.
"""
import os, sys, json, socket, base64, glob, tempfile, shutil, subprocess, threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

MODEL = os.environ.get("FABMYTH_IMG_MODEL", "x/z-image-turbo:fp8")
PORT  = int(os.environ.get("FABMYTH_IMG_PORT", "8778"))
HOST  = os.environ.get("FABMYTH_IMG_HOST", "0.0.0.0")

def guess_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80)); ip = s.getsockname()[0]; s.close(); return ip
    except Exception:
        return "127.0.0.1"

PUBLIC_URL = os.environ.get("FABMYTH_IMG_URL", "").rstrip("/")
if not PUBLIC_URL:
    ip = guess_ip() if HOST in ("0.0.0.0", "::", "") else HOST
    PUBLIC_URL = "http://%s:%d" % (ip, PORT)

EMBED_TAG = '<script src="%s/img-embed.js"></script>' % PUBLIC_URL
EMBED_TAG_ESC = EMBED_TAG.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

GEN_LOCK = threading.Lock()  # image gen is heavy: one at a time

def generate(prompt):
    """Returns (data_url, None) on success or (None, error_message)."""
    with GEN_LOCK:
        d = tempfile.mkdtemp(prefix="fabimg_")
        try:
            try:
                p = subprocess.run(["ollama", "run", MODEL, prompt],
                                   cwd=d, capture_output=True, text=True, timeout=600)
            except FileNotFoundError:
                return None, "ollama binary not found on host"
            except subprocess.TimeoutExpired:
                return None, "generation timed out (600s)"
            imgs = []
            for ext in ("*.png", "*.jpg", "*.jpeg", "*.webp"):
                imgs += glob.glob(os.path.join(d, ext))
            if not imgs:
                msg = (p.stderr or p.stdout or "").strip() or "no image was produced"
                return None, msg[:400]
            imgs.sort(key=os.path.getmtime)
            path = imgs[-1]
            with open(path, "rb") as f:
                data = f.read()
            ext = os.path.splitext(path)[1].lstrip(".").lower()
            mime = "image/jpeg" if ext in ("jpg", "jpeg") else "image/" + ext
            return "data:%s;base64,%s" % (mime, base64.b64encode(data).decode()), None
        finally:
            shutil.rmtree(d, ignore_errors=True)

EMBED_JS = r'''(function(){
  var cs=document.currentScript;
  if(!cs){var ss=document.getElementsByTagName('script');cs=ss[ss.length-1];}
  var base=cs.src.replace(/\/img-embed\.js.*$/,'');
  var title=cs.getAttribute('data-fabmyth-title')||'AI Image Generator';
  var accent=cs.getAttribute('data-fabmyth-color')||'#4f46e5';
  var css=[
   '.fmi-btn{position:fixed;right:20px;bottom:20px;z-index:2147483000;width:56px;height:56px;border-radius:50%;border:none;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.25);font-size:24px;color:#fff;background:'+accent+'}',
   '.fmi-panel{position:fixed;right:20px;bottom:88px;z-index:2147483000;width:min(380px,94vw);background:#fff;color:#111;border-radius:14px;box-shadow:0 12px 40px rgba(0,0,0,.3);display:none;flex-direction:column;overflow:hidden;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}',
   '.fmi-panel.open{display:flex}',
   '.fmi-head{background:'+accent+';color:#fff;padding:12px 14px;font-weight:600;display:flex;justify-content:space-between;align-items:center}',
   '.fmi-x{cursor:pointer;background:none;border:none;color:#fff;font-size:20px;line-height:1}',
   '.fmi-body{padding:12px;display:flex;flex-direction:column;gap:8px}',
   '.fmi-img{width:100%;border-radius:10px;display:none;background:#f0f0f2;min-height:40px}',
   '.fmi-in{border:1px solid #d1d5db;border-radius:10px;padding:9px 11px;font-size:14px;outline:none;width:100%}',
   '.fmi-go{border:none;background:'+accent+';color:#fff;border-radius:10px;padding:10px;cursor:pointer;font-size:14px}',
   '.fmi-go:disabled{opacity:.6;cursor:default}',
   '.fmi-status{font-size:12px;color:#6b7280;min-height:16px}',
   '.fmi-cred{font-size:11px;color:#9ca3af;text-align:center;padding:4px}',
   '@media (prefers-color-scheme:dark){.fmi-panel{background:#1f2023;color:#eee}.fmi-in{background:#26272b;color:#eee;border-color:#3a3b40}.fmi-img{background:#17181a}}'
  ].join('');
  var st=document.createElement('style');st.textContent=css;document.head.appendChild(st);
  var btn=document.createElement('button');btn.className='fmi-btn';btn.innerHTML='&#127912;';btn.title=title;
  var panel=document.createElement('div');panel.className='fmi-panel';
  panel.innerHTML='<div class="fmi-head"><span></span><button class="fmi-x" aria-label="close">&times;</button></div>'+
    '<div class="fmi-body">'+
    '<img class="fmi-img" alt="generated image">'+
    '<input class="fmi-in" placeholder="Describe an image...">'+
    '<button class="fmi-go">Generate</button>'+
    '<div class="fmi-status"></div></div>'+
    '<div class="fmi-cred">powered by FaB-Myth-Ai</div>';
  document.body.appendChild(btn);document.body.appendChild(panel);
  panel.querySelector('.fmi-head span').textContent=title;
  var img=panel.querySelector('.fmi-img'),input=panel.querySelector('.fmi-in'),go=panel.querySelector('.fmi-go'),status=panel.querySelector('.fmi-status');
  function toggle(open){panel.classList.toggle('open',open);if(open)input.focus();}
  btn.onclick=function(){toggle(!panel.classList.contains('open'));};
  panel.querySelector('.fmi-x').onclick=function(){toggle(false);};
  var busy=false;
  function gen(){
    var prompt=(input.value||'').trim();if(!prompt||busy)return;
    busy=true;go.disabled=true;status.textContent='Generating (this can take a bit)...';
    fetch(base+'/api/image',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:prompt})})
     .then(function(r){return r.json();})
     .then(function(j){
       if(j.image){img.src=j.image;img.style.display='block';status.textContent='';}
       else{status.textContent='Error: '+(j.error||'failed');}
     })
     .catch(function(e){status.textContent='Network error: '+e;})
     .then(function(){busy=false;go.disabled=false;});
  }
  go.onclick=gen;
  input.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();gen();}});
})();'''

DEMO_TMPL = '''<!doctype html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>FaB-Myth Image Host - __MODEL__</title>
<style>body{font-family:system-ui,-apple-system,sans-serif;max-width:720px;margin:40px auto;padding:0 16px;line-height:1.55;color:#111}h1{margin-bottom:2px}code,pre{background:#f3f4f6;border-radius:6px}pre{padding:14px;overflow:auto;white-space:pre-wrap;word-break:break-all}small{color:#666}button.copy{margin-top:6px;padding:8px 12px;border:1px solid #d1d5db;border-radius:8px;background:#fff;cursor:pointer}@media(prefers-color-scheme:dark){body{background:#111;color:#eee}code,pre{background:#1e1e22}button.copy{background:#26272b;color:#eee;border-color:#3a3b40}}</style>
</head><body>
<h1>FaB-Myth Image Host</h1>
<small>Serving <b>__MODEL__</b> &mdash; visitors generate images here without downloading the model. No API key.</small>
<h2>Add it to your website</h2>
<p>Paste this one tag before <code>&lt;/body&gt;</code>:</p>
<pre id="tag">__TAGESC__</pre>
<button class="copy" onclick="navigator.clipboard.writeText(document.getElementById('tag').textContent);this.textContent='Copied!'">Copy tag</button>
<h2>Live preview</h2>
<p>Use the paint-palette button in the bottom-right of this page to generate an image.</p>
<p><small>Endpoint: <code>POST __URL__/api/image</code> body <code>{"prompt":"..."}</code> &middot; health: <code>__URL__/health</code></small></p>
__TAG__
</body></html>'''
DEMO_HTML = (DEMO_TMPL.replace("__MODEL__", MODEL)
                      .replace("__URL__", PUBLIC_URL)
                      .replace("__TAGESC__", EMBED_TAG_ESC)
                      .replace("__TAG__", EMBED_TAG))

class Handler(BaseHTTPRequestHandler):
    def _cors(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "POST, GET, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
    def _send(self, code, body, ctype="application/json"):
        if isinstance(body, str): body = body.encode()
        self.send_response(code); self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body))); self._cors(); self.end_headers()
        self.wfile.write(body)
    def do_OPTIONS(self):
        self.send_response(204); self._cors(); self.end_headers()
    def do_GET(self):
        p = self.path.split("?")[0]
        if p == "/img-embed.js":
            self._send(200, EMBED_JS, "application/javascript; charset=utf-8")
        elif p in ("/", "/index.html", "/demo"):
            self._send(200, DEMO_HTML, "text/html; charset=utf-8")
        elif p == "/health":
            self._send(200, json.dumps({"ok": True, "model": MODEL}))
        else:
            self._send(404, json.dumps({"error": "not found"}))
    def do_POST(self):
        if self.path.split("?")[0] != "/api/image":
            self._send(404, json.dumps({"error": "not found"})); return
        try:
            ln = int(self.headers.get("Content-Length", 0))
            payload = json.loads(self.rfile.read(ln).decode() or "{}")
        except Exception:
            self._send(400, json.dumps({"error": "invalid JSON"})); return
        prompt = (payload.get("prompt") or "").strip()
        if not prompt:
            self._send(400, json.dumps({"error": "no prompt provided"})); return
        data_url, err = generate(prompt[:2000])
        if err:
            self._send(502, json.dumps({"error": err})); return
        self._send(200, json.dumps({"image": data_url, "model": MODEL}))
    def log_message(self, *a):
        pass

def main():
    print("FaB-Myth Image Host")
    print("  model      : %s" % MODEL)
    print("  binding    : %s:%d" % (HOST, PORT))
    print("  public url : %s" % PUBLIC_URL)
    print()
    print("Paste this ONE tag into your website (no API key needed):")
    print()
    print("    " + EMBED_TAG)
    print()
    print("Preview / copy page: %s" % PUBLIC_URL)
    print("Visitors generate images via this host -- they never download the model.")
    print("Press Ctrl-C to stop.")
    print()
    try:
        ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")
    except OSError as e:
        sys.stderr.write("Could not bind %s:%d -- %s\n" % (HOST, PORT, e)); sys.exit(1)

if __name__ == "__main__":
    main()
PYEOF

  info "Starting FaB-Myth Image Host for $model"
  FABMYTH_IMG_MODEL="$model" FABMYTH_IMG_PORT="$port" FABMYTH_IMG_HOST="$host" \
  FABMYTH_IMG_URL="$url" OLLAMA_HOST="$OLLAMA_HOST" \
  "$PYBIN" "$iweb_py"
}

